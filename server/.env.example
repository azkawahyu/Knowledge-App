# ============================================================
# Local Knowledge Assistant — server configuration
# Copy to .env (cp .env.example .env) and edit.
# NEVER commit .env — it holds secrets.
# ============================================================

# --- Server ---
PORT=4000
HOST=127.0.0.1

# --- PostgreSQL (use the credentials you set during install) ---
DATABASE_URL=postgresql://knowledge_app:change_me@127.0.0.1:5432/knowledge_app

# --- Admin bootstrap (first run only; no registration) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- JWT secret (auto-generated if empty — set a strong value) ---
JWT_SECRET=

# --- At-rest encryption key for sensitive fields (Fernet). Optional. ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

OPENAI_BASE_URL=https://openagentic.id/api/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=
OPENAI_MAX_TOKENS=2048

# --- Logging ---
LOG_LEVEL=info
